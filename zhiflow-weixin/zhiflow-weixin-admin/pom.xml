<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.zhiflow</groupId>
		<artifactId>zhiflow-weixin</artifactId>
		<version>1.0.5</version>
	</parent>

	<artifactId>zhiflow-weixin-admin</artifactId>
	<packaging>jar</packaging>

	<description>微信管理模块</description>

	<dependencies>
		<!-- WeChat API 接口定义 -->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-api-weixin</artifactId>
		</dependency>
		<!--mybatis-->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot4-starter</artifactId>
		</dependency>
		<!--数据库-->
<!--		<dependency>-->
<!--			<groupId>mysql</groupId>-->
<!--			<artifactId>mysql-connector-java</artifactId>-->
<!--		</dependency>-->
		<!--日志处理-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-log</artifactId>
		</dependency>
		<!--数据操作-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-data</artifactId>
		</dependency>
		<!--common-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-core</artifactId>
		</dependency>
		<!--swagger-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-swagger</artifactId>
		</dependency>
		<!--安全模块-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-security</artifactId>
		</dependency>
		<!--web 模块-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-websocket -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>
		<!--zhiflow-weixin-common-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-weixin-common</artifactId>
		</dependency>
		<!--分布式事务
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-transaction</artifactId>
		</dependency>-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <scope>compile</scope>
        </dependency>
		<!--监控-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Prometheus 抓取格式：无此依赖时 /actuator/prometheus 返回 404。
		     本模块显式引入，保证单独打包时 /actuator/prometheus 可用。
		     版本由 spring-boot-dependencies BOM 管理，不写死。 -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!-- 对照判据要 mock controller（本模块此前没有任何单测，所以这两条是新加的）。 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.zhiflow.weixin.admin.ZhiflowWeiXinApplication</mainClass>
				</configuration>
				<executions>
					<execution>
						<id>repackage</id>
						<phase>package</phase>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>io.fabric8</groupId>
				<artifactId>docker-maven-plugin</artifactId>
			</plugin>

			<!--打包时复制jar包到指定文件目录-->
		</plugins>
	</build>
</project>

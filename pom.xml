		<java.version>25</java.version>
		<!-- spring-security-oauth2-authorization-server 的版本交给 spring-boot-dependencies 管理
		     （Boot 4.1.1 → Spring Security 7.1.1，授权服务器已并入 Security 主线、随 spring-security.version）。此前显式锁 1.5.0 会把 BOM 的补丁版本顶掉，不要加回来。 -->
		<mybatis-plus.version>3.5.16</mybatis-plus.version>
		<!-- 对齐 MyBatis-Plus 3.5.16 的 mybatis-plus-jsqlparser 官方绑定（该模块编译期绑 5.2）。
		     🔴 不要改回 5.0/4.9：5.0 的 WithItem 没有 getSelect()，而 TenantLineInnerInterceptor
		     的 lambda$processSelect$0 直接调它 ⇒ 任何含 WITH/CTE 的 SQL 必抛 NoSuchMethodError
		     → 运行时 500，而编译与单测都拦不住（Error 不是 Exception，且不写 CTE 就碰不到）。
		     护栏：SqlRewriteContractTest（zhiflow-common-data）固化了重写结果，版本再错开会红。 -->
		<jsqlparser.version>5.2</jsqlparser.version>
		<hutool.version>5.8.44</hutool.version>
		<!-- fastjson2 native API migration; old com.alibaba:fastjson is prohibited. -->
		<fastjson2.version>2.0.63</fastjson2.version>

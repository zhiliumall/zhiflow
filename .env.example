# 复制成 .env 后修改；或运行 scripts/init-env.sh 自动生成随机口令。.env 不要提交。

# —— 必填 ——
PG_PASSWORD=
REDIS_PASSWORD=
# 对外 id 混淆的盐，至少 32 个字符；上线后不能再改，否则已发出去的链接里的 id 解不出来
HASHIDS_SALT=

# —— 网站入口（nginx：/ 是 H5 用户端，/admin/ 是管理后台）——
# 网站的对外地址，不带结尾的 /。支付回调地址（{SITE_URL}/mallapi/paynotify/...）与后台首页的 H5 二维码都用它，上线时改成公网域名
SITE_URL=http://localhost
# 宿主机上的 HTTP / HTTPS 端口
HTTP_PORT=80
HTTPS_PORT=443
# 域名（nginx 的 server_name，多个用空格隔开）；留空接受任意域名
SERVER_NAME=
# HTTPS 证书目录：放入 fullchain.pem 和 privkey.pem 后重启 web 即启用 HTTPS（HTTP 自动跳转）；不放则只开 HTTP
SSL_CERT_DIR=./deploy/certs
# 两个前端仓库的源码目录（相对本仓库），默认三个仓库并排放
ADMIN_SRC=../zhiflow-admin
H5_SRC=../zhiflow-uniapp

# —— 后端 ——
# 后端端口，只绑在本机 127.0.0.1（排查用；对外访问一律经网站入口）
APP_PORT=8080
# 支付回调域名，默认取 SITE_URL；后端单独有公网域名时才需要设置
# NOTIFY_HOST=
# 本地存储文件的访问前缀；经网站入口访问时保持 /files
FILE_URL_PREFIX=/files

# —— 短信验证码（可选，不配则只能用户名 + 密码注册登录）——
# aliyun 或 tencent
SMS_PROVIDER=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_TENCENT_SDK_APP_ID=
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=

# —— MeiliSearch 商品搜索（可选，docker compose --profile search up -d，并把 MEILISEARCH_ENABLED 改成 true）——
MEILISEARCH_ENABLED=false
MEILI_MASTER_KEY=

# JVM 参数
JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError"

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.zhiflow</groupId>
		<artifactId>zhiflow-pay</artifactId>
		<version>1.0.5</version>
	</parent>

	<artifactId>zhiflow-pay-admin</artifactId>
	<packaging>jar</packaging>

	<description>Zhiflow支付模块</description>

	<dependencies>
		<!-- Pay API 接口定义 -->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-api-pay</artifactId>
		</dependency>
		<!-- Mall Admin API 接口定义 -->
		<!--mybatis-->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot4-starter</artifactId>
		</dependency>
		<!--数据库-->
<!--		<dependency>-->
<!--			<groupId>mysql</groupId>-->
<!--			<artifactId>mysql-connector-java</artifactId>-->
<!--		</dependency>-->
		<!--日志处理-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-log</artifactId>
		</dependency>
		<!--数据操作-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-data</artifactId>
		</dependency>
		<!--common-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-core</artifactId>
		</dependency>
		<!--swagger-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-swagger</artifactId>
		</dependency>
		<!--安全模块-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-security</artifactId>
		</dependency>
		<!--web 模块-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-pay-common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-mall-common</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--监控-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Prometheus 抓取格式：无此依赖时 /actuator/prometheus 返回 404。
		     本模块显式引入，保证单独打包时 /actuator/prometheus 可用。
		     版本由 spring-boot-dependencies BOM 管理，不写死。 -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!-- 「实体列 ⊆ 迁移列」判据（EntityColumnAudit）与 Lambda Wrapper 单测支持：pay-admin 自己的实体建在 mall 租户 schema 里 -->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-test</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.zhiflow.pay.admin.ZhiflowPayApplication</mainClass>
				</configuration>
				<executions>
					<execution>
						<id>repackage</id>
						<phase>package</phase>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>io.fabric8</groupId>
				<artifactId>docker-maven-plugin</artifactId>
			</plugin>

			<!--打包时复制jar包到指定文件目录-->
		</plugins>
	</build>
</project>

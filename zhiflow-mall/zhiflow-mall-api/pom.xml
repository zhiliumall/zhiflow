<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.zhiflow</groupId>
		<artifactId>zhiflow-mall</artifactId>
		<version>1.0.5</version>
	</parent>

	<artifactId>zhiflow-mall-api</artifactId>
	<packaging>jar</packaging>

	<description>商城api接口模块</description>

	<dependencies>
		<!-- API 接口定义 -->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-api-mall-api</artifactId>
		</dependency>
		<!-- [r3 followup C7] 实体列 ⊆ 版本化迁移的判据（EntityColumnAudit），与 mall-admin 的门禁共用一份 -->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-test</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-api-upms</artifactId>
		</dependency>
		<!--
			审计与错误日志（S12/S3 前置）。此前 mall-api 唯独缺这个依赖，导致 @SysLog 注解类
			与 SysLogAspect 切面在 C 端根本不存在——C 端写接口加注解也不会生效，且错误日志
			里一条 C 端 URI 都没有。
			本模块的 HttpClientApiConfiguration 早已注册 LogApi bean 并注明
			"required by LogAutoConfiguration"，属半成品状态，此处补完。
		-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-log</artifactId>
		</dependency>
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-api-weixin</artifactId>
		</dependency>
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-api-pay</artifactId>
		</dependency>
		<!--mybatis-->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot4-starter</artifactId>
		</dependency>
		<!--数据库-->
<!--		<dependency>-->
<!--			<groupId>mysql</groupId>-->
<!--			<artifactId>mysql-connector-java</artifactId>-->
<!--		</dependency>-->
		<!--common-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-core</artifactId>
		</dependency>
		<!--多级缓存 (Caffeine L1 + Redis L2) 跨模块复用-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-data</artifactId>
		</dependency>
		<!--Prometheus 业务指标-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!--虚拟线程指标：Boot 4.1.1 检测到它自动注册 jvm.threads.virtual.pinned / submit.failed / live 等（JFR 事件流），
		    版本由 Boot BOM 管。mall-api 已在用虚拟线程（virtualThreadExecutor / 审计上报），灰度开关前先把观测接上-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-java21</artifactId>
		</dependency>
		<!--common-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-portal</artifactId>
		</dependency>
		<!--swagger-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-swagger</artifactId>
		</dependency>
		<!--web 模块-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- zhiflow-mall-common -->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-mall-common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-weixin-common</artifactId>
		</dependency>
		<!--sms-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-sms</artifactId>
		</dependency>
		<!--job-->
		<!--storage-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-storage</artifactId>
		</dependency>
        <!--分布式事务
        <dependency>
            <groupId>com.zhiflow</groupId>
            <artifactId>zhiflow-common-transaction</artifactId>
        </dependency>-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-search</artifactId>
		</dependency>
		<!--分布式锁 Redisson-->
		<dependency>
			<groupId>com.zhiflow</groupId>
			<artifactId>zhiflow-common-lock</artifactId>
		</dependency>

		<!-- Spring Cache -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>


		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aspectj</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--监控-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.zhiflow.mall.api.ZhiflowMallApiApplication</mainClass>
				</configuration>
				<executions>
					<execution>
						<id>repackage</id>
						<phase>package</phase>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.5</version>
				<configuration>
					<argLine>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/jdk.internal.misc=ALL-UNNAMED --add-opens java.base/jdk.internal.reflect=ALL-UNNAMED -Dnet.bytebuddy.experimental=true</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>io.fabric8</groupId>
				<artifactId>docker-maven-plugin</artifactId>
			</plugin>

			<!--打包时复制jar包到指定文件目录-->
		</plugins>
	</build>
</project>
